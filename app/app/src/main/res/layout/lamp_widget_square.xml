<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="8dp" android:background="@drawable/widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp"
                android:text="@string/app_name" android:textColor="#F4E8D1" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:gravity="center_vertical"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
            <ImageView android:id="@+id/widget_connection" android:layout_width="8dp" android:layout_height="8dp"
                android:layout_marginStart="4dp" android:src="@drawable/widget_dot_unknown" android:contentDescription="@string/widget_connection_unknown" />
        </LinearLayout>
        <TextView android:id="@+id/widget_mac" android:layout_width="match_parent" android:layout_height="14dp"
            android:text="@string/widget_mac_pending" android:textColor="#A69981" android:textSize="10sp" android:fontFamily="sans-serif-condensed"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:gravity="center_vertical"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="14dp"
            android:text="@string/widget_choose" android:textColor="#A69981" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:gravity="center_vertical"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_stages" android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="@android:color/transparent" android:importantForAccessibility="no" />
    <ImageButton android:id="@+id/widget_cycle" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_button" android:contentDescription="@string/widget_cycle" android:padding="0dp" />
</LinearLayout>
