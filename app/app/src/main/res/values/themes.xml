<resources>
    <style name="Theme.OpenRhodes" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#EEAC43</item>
    </style>
    <style name="Theme.OpenRhodes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lamp_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenRhodes</item>
    </style>
</resources>
